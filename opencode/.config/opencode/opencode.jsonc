{
    "$schema": "https://opencode.ai/config.json",

    "autoupdate": false,
    "share": "disabled",

    //
    // Permissions
    // Rules are evaluated in order, with the last matching rule winning.
    //

    "permission": {
        "bash": {
            "*": "ask",

            "RAILS_ENV=test bundle exec rspec *": "allow",
            "git add *": "allow",
            "git branch -l *": "allow",
            "git branch --list *": "allow",
            "git checkout -b": "allow",
            "git switch *": "allow",
            "git diff *": "allow",
            "git status": "allow",
            "git status *": "allow",
            "git -C . add *": "allow",
            "git -C . checkout -b *": "allow",
            "git -C . switch -b *": "allow",
            "git -C . diff *": "allow",
            "git -C . status *": "allow",

            "env": "deny",
            "printenv": "deny",
            "set": "deny",
            "export": "deny",
            "alias": "deny",
            "declare *": "deny",
            "typeset *": "deny",
            "echo $*": "deny",
            "cat /proc/*/environ": "deny",
            "strings /proc/*/environ": "deny",
            "git am *": "deny",
            "git apply *": "deny",
            "git branch -D*": "deny",
            "git branch -d*": "deny",
            "git branch --delete *": "deny",
            "git branch --force --delete *": "deny",
            "git checkout -- *": "deny",
            "git checkout .": "deny",
            "git checkout --force *": "deny",
            "git cherry-pick *": "deny",
            "git clean *": "deny",
            "git commit -a *": "deny",
            "git commit --amend *": "deny",
            "git fetch *": "deny",
            "git fetch --prune *": "deny",
            "git merge *": "deny",
            "git pull *": "deny",
            "git push *": "deny",
            "git rebase *": "deny",
            "git reset *": "deny",
            "git restore *": "deny",
            "git revert *": "deny",
            "git stash *": "deny",
            "git switch --discard-changes *": "deny",
            "git switch -f *": "deny",
            "git switch --force *": "deny",
            "git update-ref *": "deny",
            "git worktree remove *": "deny",
            "git worktree prune *": "deny",
            "curl *": "deny",
            "wget *": "deny",
            "ftp *": "deny",
            "sftp *": "deny",
            "ssh *": "deny",
            "rsync *": "deny",
            "nc *": "deny",
            "netcat *": "deny",
            "telnet *": "deny",
            "ping *": "deny",
            "dig *": "deny",
            "nslookup *": "deny",
            "host *": "deny",
            "chgrp *": "deny",
            "chmod *": "deny",
            "chown *": "deny",
            "rm -f*": "deny",
            "defaults read *": "deny",
            "defaults write *": "deny",
            "ioreg *": "deny",
            "pbpaste": "deny",
            "pbpaste *": "deny",
            "security *": "deny",
            "ssh-add -L": "deny",
            "ssh-add -l": "deny",
            "system_profiler *": "deny",
            "xattr *": "deny",
        },
        "read": {
            "*": "allow",

            "/etc/fstab": "deny",
            "/etc/hosts": "deny",
            "/etc/passwd": "deny",
            "/etc/shadow": "deny",
            "/proc/*": "deny",
            "/var/lib/*": "deny",
            "~/Documents/**": "deny",
            "~/Downloads/**": "deny",
            "~/Library/Application Support/**": "deny",
            "~/Library/Containers/**": "deny",
            "~/Library/Developer/**": "deny",
            "~/Library/Group Containers/**": "deny",
            "~/Library/Keychains/**": "deny",
            "~/Library/Logs/**": "deny",
            "~/Library/MobileDevice/**": "deny",
            "~/Library/Preferences/**": "deny",
            "~/Library/Safari/**": "deny",
            "~/Movies/**": "deny",
            "~/Music/**": "deny",
            "~/Pictures/**": "deny",
            "/opt/homebrew/**": "deny",
            "/usr/local/**": "deny",
            "~/.Trash/**": "deny",
            "~/.anyconnect": "deny",
            "~/.atuin/**": "deny",
            "~/.aws/**": "deny",
            "~/.bash_history": "deny",
            "~/.bashrc": "deny",
            "~/.bun/**": "deny",
            "~/.cache/**": "deny",
            "~/.cisco/**": "deny",
            "~/.claude-code-session/**": "deny",
            "~/.claude.json/**": "deny",
            "~/.codex/**": "deny",
            "~/.composer/**": "deny",
            "~/.config/**": "deny",
            "~/.docker/**": "deny",
            "~/.dotnet/**": "deny",
            "~/.git-credentials": "deny",
            "~/.gitconfig": "deny",
            "~/.gnupg/**": "deny",
            "~/.gradle/**": "deny",
            "~/.history": "deny",
            "~/.irb_history": "deny",
            "~/.lesshst": "deny",
            "~/.local/share/**": "deny",
            "~/.local/state/**": "deny",
            "~/.m2/**": "deny",
            "~/.mysql_history": "deny",
            "~/.netrc": "deny",
            "~/.npm/**": "deny",
            "~/.nuget/**": "deny",
            "~/.profile": "deny",
            "~/.python_history": "deny",
            "~/.sqlite_history": "deny",
            "~/.ssh/**": "deny",
            "~/.terraform.d/**": "deny",
            "~/.terraform/**": "deny",
            "~/.vault-token/**": "deny",
            "~/.yarn/**": "deny",
            "~/.zlogin": "deny",
            "~/.zlogout": "deny",
            "~/.zprofile": "deny",
            "~/.zsh*": "deny",
            "*.age": "deny",
            "*.crt": "deny",
            "*.gpg": "deny",
            "*.key": "deny",
            "*.pem": "deny",
            "*.pgp": "deny",
            "*.pub": "deny",
            "*.p12": "deny",
            "*.pfx": "deny",
            "*.secrets.*": "deny",
            "*.env*": "deny",
            "*auth.json": "deny",
            "*credentials.*": "deny",
            "*id_rsa*": "deny",
            "*id_ed25519*": "deny",
            "*mise.toml": "deny",
            "*.npmrc": "deny",
        },
    },

    //
    // Default models
    //

    // "model": "opencode/gpt-5-nano",
    "small_model": "opencode/gpt-5-nano",

    //
    // Watcher ignore
    //

    "watcher": {
        "ignore": ["node_modules/**", "dist/**", ".git/**"],
    },

    //
    // Providers
    //

    "provider": {
        // "anthropic": {
        //     "models": {},
        //     "options": {
        //         "apiKey": "{env:ANTHROPIC_API_KEY}",
        //     },
        // },
        // "openai": {
        //     "models": {},
        //     "options": {
        //         "apiKey": "{env:OPENAI_API_KEY}",
        //     },
        // },
    },

    //
    // Formatters
    //

    "formatter": {
        "pint": {
            "command": ["./vendor/bin/pint", "$FILE"],
            "extensions": [".php"],
        },
    },

}
