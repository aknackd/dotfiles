{
    "$schema": "https://opencode.ai/config.json",

    "update": "disable",
    "share": "disabled",

    //
    // Permissions
    // Rules are evaluated in order, with the last matching rule winning.
    //

    "permissions": [
        { "action": "shell",     "resource": "*",                                   "effect": "ask"   },

        // -- SHELL ACTIONS
        { "action": "shell",     "resource": "RAILS_ENV=test bundle exec rspec *",  "effect": "allow" },
        { "action": "shell",     "resource": "alias",                               "effect": "deny"  },
        { "action": "shell",     "resource": "basename *",                          "effect": "allow" },
        { "action": "shell",     "resource": "bun *",                               "effect": "allow" },
        { "action": "shell",     "resource": "bundle *",                            "effect": "allow" },
        { "action": "shell",     "resource": "cat /proc/*/environ",                 "effect": "deny"  },
        { "action": "shell",     "resource": "chgrp *",                             "effect": "deny"  },
        { "action": "shell",     "resource": "chmod *",                             "effect": "deny"  },
        { "action": "shell",     "resource": "chown *",                             "effect": "deny"  },
        { "action": "shell",     "resource": "command -v *",                        "effect": "allow" },
        { "action": "shell",     "resource": "composer *",                          "effect": "deny"  },
        { "action": "shell",     "resource": "curl *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "declare *",                           "effect": "deny"  },
        { "action": "shell",     "resource": "defaults read *",                     "effect": "deny"  },
        { "action": "shell",     "resource": "defaults write *",                    "effect": "deny"  },
        { "action": "shell",     "resource": "df *",                                "effect": "allow" },
        { "action": "shell",     "resource": "diff *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "dig *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "dirname *",                           "effect": "allow" },
        { "action": "shell",     "resource": "du *",                                "effect": "allow" },
        { "action": "shell",     "resource": "echo $*",                             "effect": "deny"  },
        { "action": "shell",     "resource": "env",                                 "effect": "deny"  },
        { "action": "shell",     "resource": "export",                              "effect": "deny"  },
        { "action": "shell",     "resource": "file *",                              "effect": "allow" },
        { "action": "shell",     "resource": "find *",                              "effect": "allow" },
        { "action": "shell",     "resource": "ftp *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "git -C . add *",                      "effect": "allow" },
        { "action": "shell",     "resource": "git -C . checkout -b *",              "effect": "allow" },
        { "action": "shell",     "resource": "git -C . diff *",                     "effect": "allow" },
        { "action": "shell",     "resource": "git -C . status *",                   "effect": "allow" },
        { "action": "shell",     "resource": "git -C . switch -b *",                "effect": "allow" },
        { "action": "shell",     "resource": "git add *",                           "effect": "allow" },
        { "action": "shell",     "resource": "git am *",                            "effect": "deny"  },
        { "action": "shell",     "resource": "git apply *",                         "effect": "deny"  },
        { "action": "shell",     "resource": "git branch --delete *",               "effect": "deny"  },
        { "action": "shell",     "resource": "git branch --force --delete *",       "effect": "deny"  },
        { "action": "shell",     "resource": "git branch --list *",                 "effect": "allow" },
        { "action": "shell",     "resource": "git branch -D*",                      "effect": "deny"  },
        { "action": "shell",     "resource": "git branch -d*",                      "effect": "deny"  },
        { "action": "shell",     "resource": "git branch -l *",                     "effect": "allow" },
        { "action": "shell",     "resource": "git checkout -- *",                   "effect": "deny"  },
        { "action": "shell",     "resource": "git checkout --force *",              "effect": "deny"  },
        { "action": "shell",     "resource": "git checkout -b",                     "effect": "allow" },
        { "action": "shell",     "resource": "git checkout .",                      "effect": "deny"  },
        { "action": "shell",     "resource": "git cherry-pick *",                   "effect": "deny"  },
        { "action": "shell",     "resource": "git clean *",                         "effect": "deny"  },
        { "action": "shell",     "resource": "git commit --amend *",                "effect": "deny"  },
        { "action": "shell",     "resource": "git commit -a *",                     "effect": "deny"  },
        { "action": "shell",     "resource": "git diff *",                          "effect": "allow" },
        { "action": "shell",     "resource": "git fetch *",                         "effect": "deny"  },
        { "action": "shell",     "resource": "git fetch --prune *",                 "effect": "deny"  },
        { "action": "shell",     "resource": "git merge *",                         "effect": "deny"  },
        { "action": "shell",     "resource": "git pull *",                          "effect": "deny"  },
        { "action": "shell",     "resource": "git push *",                          "effect": "deny"  },
        { "action": "shell",     "resource": "git rebase *",                        "effect": "deny"  },
        { "action": "shell",     "resource": "git reset *",                         "effect": "deny"  },
        { "action": "shell",     "resource": "git restore *",                       "effect": "deny"  },
        { "action": "shell",     "resource": "git revert *",                        "effect": "deny"  },
        { "action": "shell",     "resource": "git show *",                          "effect": "allow" },
        { "action": "shell",     "resource": "git stash *",                         "effect": "deny"  },
        { "action": "shell",     "resource": "git status *",                        "effect": "allow" },
        { "action": "shell",     "resource": "git status",                          "effect": "allow" },
        { "action": "shell",     "resource": "git switch *",                        "effect": "allow" },
        { "action": "shell",     "resource": "git switch --discard-changes *",      "effect": "deny"  },
        { "action": "shell",     "resource": "git switch --force *",                "effect": "deny"  },
        { "action": "shell",     "resource": "git switch -f *",                     "effect": "deny"  },
        { "action": "shell",     "resource": "git update-ref *",                    "effect": "deny"  },
        { "action": "shell",     "resource": "git worktree prune *",                "effect": "deny"  },
        { "action": "shell",     "resource": "git worktree remove *",               "effect": "deny"  },
        { "action": "shell",     "resource": "host *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "ioreg *",                             "effect": "deny"  },
        { "action": "shell",     "resource": "ln *",                                "effect": "allow" },
        { "action": "shell",     "resource": "ls *",                                "effect": "allow" },
        { "action": "shell",     "resource": "mkdir *",                             "effect": "allow" },
        { "action": "shell",     "resource": "nc *",                                "effect": "deny"  },
        { "action": "shell",     "resource": "netcat *",                            "effect": "deny"  },
        { "action": "shell",     "resource": "node *",                              "effect": "allow" },
        { "action": "shell",     "resource": "nslookup *",                          "effect": "deny"  },
        { "action": "shell",     "resource": "pbpaste *",                           "effect": "deny"  },
        { "action": "shell",     "resource": "perl *",                              "effect": "allow" },
        { "action": "shell",     "resource": "php *",                               "effect": "allow" },
        { "action": "shell",     "resource": "ping *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "podman *",                            "effect": "allow" },
        { "action": "shell",     "resource": "printenv",                            "effect": "deny"  },
        { "action": "shell",     "resource": "pwd *",                               "effect": "allow" },
        { "action": "shell",     "resource": "python3 *",                           "effect": "allow" },
        { "action": "shell",     "resource": "readlink *",                          "effect": "allow" },
        { "action": "shell",     "resource": "realpath *",                          "effect": "allow" },
        { "action": "shell",     "resource": "rg *",                                "effect": "allow" },
        { "action": "shell",     "resource": "rm -f*",                              "effect": "deny"  },
        { "action": "shell",     "resource": "rsync *",                             "effect": "deny"  },
        { "action": "shell",     "resource": "ruby *",                              "effect": "allow" },
        { "action": "shell",     "resource": "security *",                          "effect": "deny"  },
        { "action": "shell",     "resource": "set",                                 "effect": "deny"  },
        { "action": "shell",     "resource": "sftp *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "ssh *",                               "effect": "ask"   },
        { "action": "shell",     "resource": "ssh-add -L",                          "effect": "deny"  },
        { "action": "shell",     "resource": "ssh-add -l",                          "effect": "deny"  },
        { "action": "shell",     "resource": "stat *",                              "effect": "allow" },
        { "action": "shell",     "resource": "strings /proc/*/environ",             "effect": "deny"  },
        { "action": "shell",     "resource": "su *",                                "effect": "deny"  },
        { "action": "shell",     "resource": "sudo *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "system_profiler *",                   "effect": "deny"  },
        { "action": "shell",     "resource": "telnet *",                            "effect": "deny"  },
        { "action": "shell",     "resource": "tree *",                              "effect": "allow" },
        { "action": "shell",     "resource": "typeset *",                           "effect": "deny"  },
        { "action": "shell",     "resource": "vp *",                                "effect": "allow" },
        { "action": "shell",     "resource": "wget *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "which *",                             "effect": "allow" },
        { "action": "shell",     "resource": "xattr *",                             "effect": "deny"  },

        // -- PACKAGE MANAGERS
        // Fail closed: permit only the read-only queries listed below.
        { "action": "shell",     "resource": "apt *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "apt-cache *",                         "effect": "deny"  },
        { "action": "shell",     "resource": "apt-get *",                           "effect": "deny"  },
        { "action": "shell",     "resource": "aptitude *",                          "effect": "deny"  },
        { "action": "shell",     "resource": "apk *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "brew *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "dnf *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "dnf5 *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "dpkg *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "doas *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "flatpak *",                           "effect": "deny"  },
        { "action": "shell",     "resource": "nix *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "nix-env *",                           "effect": "deny"  },
        { "action": "shell",     "resource": "pacman *",                            "effect": "deny"  },
        { "action": "shell",     "resource": "pkexec *",                            "effect": "deny"  },
        { "action": "shell",     "resource": "port *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "rpm *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "run0 *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "snap *",                              "effect": "deny"  },
        { "action": "shell",     "resource": "yum *",                               "effect": "deny"  },
        { "action": "shell",     "resource": "zypper *",                            "effect": "deny"  },

        // Read-only package and installed-package queries (later rules override the manager deny).
        { "action": "shell",     "resource": "apt list *",                         "effect": "allow" },
        { "action": "shell",     "resource": "apt search *",                       "effect": "allow" },
        { "action": "shell",     "resource": "apt show *",                         "effect": "allow" },
        { "action": "shell",     "resource": "apt-cache depends *",                "effect": "allow" },
        { "action": "shell",     "resource": "apt-cache policy *",                 "effect": "allow" },
        { "action": "shell",     "resource": "apt-cache rdepends *",               "effect": "allow" },
        { "action": "shell",     "resource": "apt-cache search *",                 "effect": "allow" },
        { "action": "shell",     "resource": "apt-cache show *",                   "effect": "allow" },
        { "action": "shell",     "resource": "apk info *",                         "effect": "allow" },
        { "action": "shell",     "resource": "apk list *",                         "effect": "allow" },
        { "action": "shell",     "resource": "apk policy *",                       "effect": "allow" },
        { "action": "shell",     "resource": "apk search *",                       "effect": "allow" },
        { "action": "shell",     "resource": "brew desc *",                        "effect": "allow" },
        { "action": "shell",     "resource": "brew info *",                        "effect": "allow" },
        { "action": "shell",     "resource": "brew list *",                        "effect": "allow" },
        { "action": "shell",     "resource": "brew outdated *",                    "effect": "allow" },
        { "action": "shell",     "resource": "brew search *",                      "effect": "allow" },
        { "action": "shell",     "resource": "dnf check-update *",                 "effect": "allow" },
        { "action": "shell",     "resource": "dnf info *",                         "effect": "allow" },
        { "action": "shell",     "resource": "dnf list *",                         "effect": "allow" },
        { "action": "shell",     "resource": "dnf repoquery *",                    "effect": "allow" },
        { "action": "shell",     "resource": "dnf search *",                       "effect": "allow" },
        { "action": "shell",     "resource": "dnf5 check-update *",                "effect": "allow" },
        { "action": "shell",     "resource": "dnf5 info *",                        "effect": "allow" },
        { "action": "shell",     "resource": "dnf5 list *",                        "effect": "allow" },
        { "action": "shell",     "resource": "dnf5 repoquery *",                   "effect": "allow" },
        { "action": "shell",     "resource": "dnf5 search *",                      "effect": "allow" },
        { "action": "shell",     "resource": "dpkg -l*",                           "effect": "allow" },
        { "action": "shell",     "resource": "dpkg --list *",                      "effect": "allow" },
        { "action": "shell",     "resource": "dpkg --status *",                    "effect": "allow" },
        { "action": "shell",     "resource": "dpkg -s *",                          "effect": "allow" },
        { "action": "shell",     "resource": "dpkg-query *",                       "effect": "allow" },
        { "action": "shell",     "resource": "flatpak info *",                     "effect": "allow" },
        { "action": "shell",     "resource": "flatpak list *",                     "effect": "allow" },
        { "action": "shell",     "resource": "flatpak search *",                   "effect": "allow" },
        { "action": "shell",     "resource": "nix-env --query *",                  "effect": "allow" },
        { "action": "shell",     "resource": "nix-env -q*",                        "effect": "allow" },
        { "action": "shell",     "resource": "nix profile history *",              "effect": "allow" },
        { "action": "shell",     "resource": "nix profile list *",                 "effect": "allow" },
        { "action": "shell",     "resource": "nix search *",                       "effect": "allow" },
        { "action": "shell",     "resource": "pacman --query *",                   "effect": "allow" },
        { "action": "shell",     "resource": "pacman -Q*",                         "effect": "allow" },
        { "action": "shell",     "resource": "pacman -Si *",                       "effect": "allow" },
        { "action": "shell",     "resource": "pacman -Ss *",                       "effect": "allow" },
        { "action": "shell",     "resource": "port info *",                        "effect": "allow" },
        { "action": "shell",     "resource": "port installed *",                   "effect": "allow" },
        { "action": "shell",     "resource": "port search *",                      "effect": "allow" },
        { "action": "shell",     "resource": "port variants *",                    "effect": "allow" },
        { "action": "shell",     "resource": "rpm --query *",                      "effect": "allow" },
        { "action": "shell",     "resource": "rpm -q*",                            "effect": "allow" },
        { "action": "shell",     "resource": "snap find *",                        "effect": "allow" },
        { "action": "shell",     "resource": "snap info *",                        "effect": "allow" },
        { "action": "shell",     "resource": "snap list *",                        "effect": "allow" },
        { "action": "shell",     "resource": "yum check-update *",                 "effect": "allow" },
        { "action": "shell",     "resource": "yum info *",                         "effect": "allow" },
        { "action": "shell",     "resource": "yum list *",                         "effect": "allow" },
        { "action": "shell",     "resource": "yum search *",                       "effect": "allow" },
        { "action": "shell",     "resource": "zypper info *",                      "effect": "allow" },
        { "action": "shell",     "resource": "zypper packages *",                  "effect": "allow" },
        { "action": "shell",     "resource": "zypper search *",                    "effect": "allow" },

        // -- READ ACTIONS
        { "action": "read",      "resource": "*",                                  "effect": "allow" },
        { "action": "read",      "resource": "/etc/**",                            "effect": "deny"  },
        { "action": "read",      "resource": "/private/etc/**",                    "effect": "deny"  },
        { "action": "read",      "resource": "/root/**",                           "effect": "deny"  },
        { "action": "read",      "resource": "/var/root/**",                       "effect": "deny"  },
        { "action": "read",      "resource": "/private/var/root/**",               "effect": "deny"  },
        { "action": "read",      "resource": "/var/db/**",                         "effect": "deny"  },
        { "action": "read",      "resource": "/private/var/db/**",                 "effect": "deny"  },
        { "action": "read",      "resource": "/run/secrets/**",                    "effect": "deny"  },
        { "action": "read",      "resource": "/var/run/secrets/**",                "effect": "deny"  },
        { "action": "read",      "resource": "/private/var/run/secrets/**",        "effect": "deny"  },
        { "action": "read",      "resource": "/Library/Keychains/**",              "effect": "deny"  },
        { "action": "read",      "resource": "/System/Library/Keychains/**",       "effect": "deny"  },
        { "action": "read",      "resource": "/etc/fstab",                         "effect": "deny"  },
        { "action": "read",      "resource": "/etc/hosts",                         "effect": "deny"  },
        { "action": "read",      "resource": "/etc/passwd",                        "effect": "deny"  },
        { "action": "read",      "resource": "/etc/shadow",                        "effect": "deny"  },
        { "action": "read",      "resource": "/proc/*",                            "effect": "deny"  },
        { "action": "read",      "resource": "/var/lib/*",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/Documents/**",                     "effect": "deny"  },
        { "action": "read",      "resource": "~/Downloads/**",                     "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Application Support/**",   "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Containers/**",            "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Developer/**",             "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Group Containers/**",      "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Keychains/**",             "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Logs/**",                  "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/MobileDevice/**",          "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Preferences/**",           "effect": "deny"  },
        { "action": "read",      "resource": "~/Library/Safari/**",                "effect": "deny"  },
        { "action": "read",      "resource": "~/Movies/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/Music/**",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/Pictures/**",                      "effect": "deny"  },
        { "action": "read",      "resource": "/opt/homebrew/**",                   "effect": "deny"  },
        { "action": "read",      "resource": "/usr/local/**",                      "effect": "deny"  },
        { "action": "read",      "resource": "~/.Trash/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.anyconnect",                      "effect": "deny"  },
        { "action": "read",      "resource": "~/.atuin/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.aws/**",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.azure/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.bash_history",                    "effect": "deny"  },
        { "action": "read",      "resource": "~/.bash_login",                      "effect": "deny"  },
        { "action": "read",      "resource": "~/.bash_profile",                    "effect": "deny"  },
        { "action": "read",      "resource": "~/.bashrc",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.bun/**",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.cache/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.cisco/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.claude-code-session/**",          "effect": "deny"  },
        { "action": "read",      "resource": "~/.claude/**",                       "effect": "deny"  },
        { "action": "read",      "resource": "~/.codex/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.composer/**",                     "effect": "deny"  },
        { "action": "read",      "resource": "~/.config/**",                       "effect": "deny"  },
        { "action": "read",      "resource": "~/.docker/**",                       "effect": "deny"  },
        { "action": "read",      "resource": "~/.dotnet/**",                       "effect": "deny"  },
        { "action": "read",      "resource": "~/.git-credentials",                 "effect": "deny"  },
        { "action": "read",      "resource": "~/.gitconfig",                       "effect": "deny"  },
        { "action": "read",      "resource": "~/.gnupg/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.gradle/**",                       "effect": "deny"  },
        { "action": "read",      "resource": "~/.history",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/.irb_history",                     "effect": "deny"  },
        { "action": "read",      "resource": "~/.kube/**",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/.lesshst",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/.local/share/**",                  "effect": "deny"  },
        { "action": "read",      "resource": "~/.local/state/**",                  "effect": "deny"  },
        { "action": "read",      "resource": "~/.m2/**",                           "effect": "deny"  },
        { "action": "read",      "resource": "~/.mysql_history",                   "effect": "deny"  },
        { "action": "read",      "resource": "~/.netrc",                           "effect": "deny"  },
        { "action": "read",      "resource": "~/.npm/**",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.nuget/**",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.pgpass",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.pypirc",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.profile",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/.python_history",                  "effect": "deny"  },
        { "action": "read",      "resource": "~/.sqlite_history",                  "effect": "deny"  },
        { "action": "read",      "resource": "~/.ssh/**",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.terraform.d/**",                  "effect": "deny"  },
