        { "action": "read",      "resource": "~/.vault-token",                     "effect": "deny"  },
        { "action": "read",      "resource": "~/.vault-token/**",                  "effect": "deny"  },
        { "action": "read",      "resource": "~/.yarn/**",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/.zlogin",                          "effect": "deny"  },
        { "action": "read",      "resource": "~/.zlogout",                         "effect": "deny"  },
        { "action": "read",      "resource": "~/.zprofile",                        "effect": "deny"  },
        { "action": "read",      "resource": "~/.zsh*",                            "effect": "deny"  },
        { "action": "read",      "resource": "*.age",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.crt",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.gpg",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.key",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.pem",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.pgp",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.pub",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.p12",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.pfx",                              "effect": "deny"  },
        { "action": "read",      "resource": "*.secrets.*",                        "effect": "deny"  },
        { "action": "read",      "resource": "*.env*",                             "effect": "deny"  },
        { "action": "read",      "resource": "*auth.json",                         "effect": "deny"  },
        { "action": "read",      "resource": "*credentials.*",                     "effect": "deny"  },
        { "action": "read",      "resource": "*id_rsa*",                           "effect": "deny"  },
        { "action": "read",      "resource": "*id_ed25519*",                       "effect": "deny"  },
        { "action": "read",      "resource": "*mise.toml",                         "effect": "deny"  },
        { "action": "read",      "resource": "*.npmrc",                            "effect": "deny"  },

        // -- GREP ACTIONS
        { "action": "grep",       "resource": "*",                                 "effect": "allow" },
    ],

    //
    // Default title agent model
    //

    // "model": "opencode/gpt-5-nano",
    "agents": {
        "title": {
            "model": "opencode/gpt-5-nano",
        },
    },

    //
    // Watcher ignore
    //

    "watcher": {
        "ignore": ["node_modules/**", "dist/**", ".git/**"],
    },

    //
    // Providers
    //

    "providers": {},

    //
    // Formatters
    //

    "formatter": true,

}
