{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified",
    "single": false
  },
  "keybinds": {
    "session.toggle.thinking": "ctrl+o",
    "open.menu": "ctrl+shift+o",
    "prompt.editor": "ctrl+g",
    "session.first": "home,alt+home"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "indicators": "status",
    "enabled": false,
    "mode": "off"
  }
}
